{
  "max_complexity": 50,
  "niterations": 8000,
  "populations": 25,
  "population_size": 120,
  "timeout_hours": 4.0,
  "loss_function": "max_error",
  "loss_percentile": 95,
  "huber_delta": 1.0,
  "binary_operators": ["+", "-", "*", "/"],
  "unary_operators": ["abs", "sqrt", "square", "exp", "log"],
  "procs": 12,
  "multithreading": true,
  "batching": true,
  "batch_size": 150,
  "turbo": true,
  "model_selection": "best",
  "parsimony": 0.05,
  "weight_optimize": 0.01,
  "verbosity": 1,
  "progress": true,
  "save_interval_minutes": 5,
  "backup_count": 10,
  "track_progress": true,
  "progress_log_file": "training_progress.csv",
  "random_state": 42,
  "warm_start_path": null,
  "warm_start_mode": "auto"
}