{
  "max_complexity": 300,
  "niterations": 5000,
  "populations": 100,
  "population_size": 100,
  "timeout_hours": 8.0,
  "loss_function": "mse",
  "loss_percentile": 95,
  "huber_delta": 1.0,
  "binary_operators": [
    "+",
    "-",
    "*",
    "/"
  ],
  "unary_operators": [
    "abs",
    "sqrt",
    "square"
  ],
  "constraints": {
    "square": 3,
    "sqrt": 3,
    "abs": 2
  },
  "nested_constraints": {
    "square": {
      "square": 1
    },
    "sqrt": {
      "sqrt": 1
    }
  },
  "procs": 8,
  "parallelism": "multiprocessing",
  "batching": true,
  "batch_size": 100,
  "turbo": false,
  "deterministic": false,
  "optimizer_iterations": 8,
  "fast_cycle": false,
  "model_selection": "best",
  "parsimony": 0.01,
  "weight_optimize": 0.001,
  "verbosity": 1,
  "progress": true,
  "save_interval_minutes": 0.5,
  "backup_count": 5,
  "random_state": 42,
  "warm_start": false,
  "warm_start_path": null,
  "warm_start_mode": "auto",
  "warm_start_increase_complexity": true
}